{
  "name": "threejs-dungeon-crawl",
  "version": "1.0.0",
  "type": "module",
  "description": "8-Bit Point and Click Dungeon Crawl Game built with Three.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --test tests/unit/*.test.js"
  },
  "keywords": [
    "threejs",
    "game",
    "dungeon-crawl",
    "point-and-click",
    "retro"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "mongodb": "^7.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "typescript": "~6.0.0"
  }
}
